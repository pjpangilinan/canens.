# Secrets - backend/.env holds the bucket and table names and must never be
# committed. Keep .env.example tracked.
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node
node_modules/

# Next.js
.next/
out/
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
blob-report/

# Tooling scratch
.serena/
.scratch/

# SAM build output. Regenerated by `sam build`, and the image it produces is
# tens of megabytes.
.aws-sam/

# Local databases, from before the snapshot moved to S3. Kept ignored so an old
# file cannot be committed back by accident.
canens.db
*.db
*.sqlite
*.sqlite3

# IDE / Editor
.claude/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local verification output
verify.log
verify.err

# Next.js dev server output
web/dev.log
web/dev.err
