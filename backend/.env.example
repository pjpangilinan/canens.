# Copy to .env and adjust. Never commit .env.

# Where the whole-store snapshot is written. Locally, point this at a bucket in
# your own account; there is no database and nothing to start.
SNAPSHOT_BUCKET=canens-snapshots

# The DynamoDB table holding the daily model-call counter. One item per user per
# day, removed by TTL.
USAGE_TABLE=canens-ai-usage

# Bedrock credentials are not configured here. Locally they come from your AWS
# profile; in production from the Lambda execution role. There is no key to
# paste, and nothing to leak.
AWS_REGION=us-east-1

# Bare model id for on-demand access. If your account needs an inference
# profile, put the full profile id here instead, for example
# us.amazon.nova-lite-v1:0.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Per-token billing, so every call is capped. Raise it if the model truncates
# and reports so.
BEDROCK_MAX_TOKENS=1024

# Hard ceiling on model calls per user per day. 0 disables the cap. The count
# is kept in USAGE_TABLE, not in memory, because Lambda throws away its
# execution environments and an in-process counter would quietly reset.
AI_DAILY_CAP=200

# Exact origins allowed to call the API, comma separated. Must include the
# GitHub Pages URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Leave unset locally. In production, set a long random value. See the note in
# app/config.py: this is not real authentication, the value ships in the
# client bundle.
# API_TOKEN=
