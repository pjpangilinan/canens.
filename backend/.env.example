# Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgresql+asyncpg://canens:canens_dev_pass@localhost:5432/canens

# Bedrock credentials are not configured here. They come from the execution
# role that Lambda provides. Locally, they come from your AWS profile.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Exact origins allowed to call the API, comma separated. Must include the
# GitHub Pages URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Leave unset locally. In production, set a long random value. See the note in
# app/config.py: this is not real authentication, the value ships in the
# client bundle.
# API_TOKEN=
