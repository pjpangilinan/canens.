# Copy to .env and adjust. Never commit .env.

# Where the whole-store snapshot is written, one object per user. Locally,
# point this at a bucket in your own account; there is no database and nothing
# to start.
SNAPSHOT_BUCKET=canens-snapshots

# The DynamoDB table holding each account's daily model-call counter and the
# record that dates it. Two kinds of item: <sub>#<day> and u#<sub>.
USAGE_TABLE=canens-ai-usage

# Model calls per day, by how many days the account has existed. Index is the
# age, so this is days 0, 1 and 2+. Sign-up is open, so a new account starts
# small and climbs to a ceiling of 50. A single 0 disables the cap.
AI_DAILY_CAP_RAMP=10,25,50

# Cognito. The API Gateway JWT authorizer validates the token at the edge, so
# the function does no cryptography and these are only needed when invoking it
# directly rather than through the gateway.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Bare model id for on-demand access. If your account needs an inference
# profile, put the full profile id here instead, for example
# us.amazon.nova-lite-v1:0.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Per-token billing, so every call is capped. Raise it if the model truncates
# and reports so.
BEDROCK_MAX_TOKENS=1024

# Exact origins allowed to call the API, comma separated. Must include the
# GitHub Pages URL in production, and it is the only thing the API checks: there
# is no shared token any more, the Cognito token is the authorisation.
ALLOWED_ORIGINS=http://localhost:3000
